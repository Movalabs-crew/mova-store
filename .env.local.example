# Copy to `.env.local` and fill in.
# Required fields are marked with [REQUIRED]
# Server-only variables (no NEXT_PUBLIC_ prefix) are secret: never commit them,
# never expose them to the browser, and set them in your host's environment config.

# =============================================================================
# STELLAR / SOROBAN PAYMENTS
# =============================================================================

# [REQUIRED] Network: "testnet" (default) or "mainnet".
# Unrecognised values fail validation.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# USD price of 1 XLM. Required for native XLM payments (display + tx).
# Testnet reference only — do NOT ship a hardcoded market rate.
NEXT_PUBLIC_XLM_USD_PRICE=

# Soroban RPC endpoint (testnet default is used when empty)
# NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (testnet default is used when empty)
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# [REQUIRED] Deployed checkout contract id (run scripts/deploy-testnet.sh)
NEXT_PUBLIC_CHECKOUT_CONTRACT_ID=

# Ledger the checkout contract was deployed in. The admin orders view scans
# from here (instead of the ~8-minute rolling backfill window) so orders paid
# earlier stay visible. Find it on stellar.expert, or:
#   stellar contract events --id <CONTRACT_ID> --network testnet --start-ledger <LEDGER>
# 0 / unset keeps the rolling backfill.
# NEXT_PUBLIC_CHECKOUT_START_LEDGER=

# USDC token contract id (testnet default is used when empty)
# NEXT_PUBLIC_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Native XLM Stellar Asset Contract id (verified testnet default is used when empty)
# NEXT_PUBLIC_NATIVE_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# =============================================================================
# EMAILJS CONFIGURATION (for OTP and notifications)
# Get these from https://www.emailjs.com/
# =============================================================================

# [REQUIRED] Your EmailJS service ID (e.g., service_xxxxxxx)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=

# [REQUIRED] Your EmailJS template ID (e.g., template_xxxxxxx)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# [REQUIRED] Your EmailJS public key (e.g., xxxx-xxxxxxxxxx)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Default recipient email for contact forms (optional)
NEXT_PUBLIC_DEFAULT_RECIPIENT_EMAIL=

# --- Server-only EmailJS overrides (secret) ---
# When set, these take precedence over the NEXT_PUBLIC_ values above for
# server-side sending (e.g. /api/otp), keeping the values out of the client bundle.
# Leave empty to fall back to the NEXT_PUBLIC_ variables.
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=

# =============================================================================
# SUPABASE (Auth + Database + Storage)
# Get these from Supabase Dashboard → Project Settings → API
# Then run supabase/schema.sql in the SQL editor.
# =============================================================================

# [REQUIRED] Project URL (e.g., https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# [REQUIRED] anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only service-role key (secret) ---
# [REQUIRED for the order write path] Service-role key from Supabase
# Dashboard → Project Settings → API → Project API keys.
# Without it /api/orders cannot persist anything and every checkout returns
# 503 orders_store_unconfigured. This key bypasses Row Level Security —
# never ship it in client code or commit it to version control.
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

# [REQUIRED for production] Comma-separated list of admin email addresses
# Users with these emails will have access to the admin panel
NEXT_PUBLIC_ADMIN_EMAILS=

# Server-only admin allow-list used by middleware.js to gate /admin BEFORE the
# page is served. Takes precedence over NEXT_PUBLIC_ADMIN_EMAILS when set, so
# production deployments can keep the list out of the client bundle.
# Falls back to NEXT_PUBLIC_ADMIN_EMAILS when empty, so existing setups keep working.
ADMIN_EMAILS=
