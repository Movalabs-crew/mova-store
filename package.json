{
  "name": "mova-store",
  "version": "1.0.0",
  "description": "Mova Store \u2014 e-commerce with Stellar blockchain payments",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Movalabs-crew/mova-store.git"
  },
  "keywords": [
    "ecommerce",
    "stellar",
    "soroban",
    "blockchain",
    "crypto-payments",
    "nextjs",
    "web3"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bundle:report": "node scripts/bundle-report.mjs",
    "bundle:check": "node scripts/bundle-report.mjs --strict",
    "lint": "next lint --dir app --dir components --dir lib --dir hooks --dir context --dir tests --dir __tests__",
    "lint:fix": "next lint --fix --dir app --dir components --dir lib --dir hooks --dir context --dir tests --dir __tests__",
    "type-check": "tsc --noEmit --skipLibCheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "check:case": "node scripts/check-case-collisions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "verify": "npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run format:check",
    "test:naming": "node scripts/check-test-names.mjs",
    "triage": "node scripts/triage-prs.mjs",
    "deploy:testnet": "./scripts/deploy-testnet.sh",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/og": "^1.0.3",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "nextjs-toploader": "^3.9.17",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.7.0",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.2.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^8",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
