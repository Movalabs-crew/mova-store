{
  "name": "mova-store",
  "version": "1.0.0",
  "description": "Mova Store — e-commerce with Stellar blockchain payments",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Movalabs-crew/mova-store.git"
  },
  "keywords": [
    "ecommerce",
    "stellar",
    "soroban",
    "blockchain",
    "crypto-payments",
    "nextjs",
    "web3"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit --skipLibCheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "deploy:testnet": "./scripts/deploy-testnet.sh",
    "prepare": "echo 'Mova Store ready!'"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/og": "^0.6.2",
    "next": "15.5.26",
    "next-auth": "^4.24.7",
    "nextjs-toploader": "^1.6.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.2.1",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^8",
    "eslint-config-next": "15.5.26",
    "jsdom": "^24.0.0",
    "postcss": "^8",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    },
    "eslint-config-next": {
      "glob": "^10.5.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.8"
    }
  }
}
